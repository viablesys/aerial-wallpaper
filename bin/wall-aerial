#!/bin/bash
# Loop Apple Aerial footage fullscreen.
# Args: a playlist name from .meta/playlists/<name>.txt, or categories (Space Underwater Cities Landscapes), or "all".
# No args: the name in .meta/default (falls back to all categories).
# q or Esc quits, > / < skip.
# Each video start is logged to .meta/played.log (bin/log-played.lua); shot IDs listed in .meta/skip.txt are left out.
root=~/Videos/aerial
meta=$root/.meta
all=(Space Underwater Cities Landscapes)
ids() { sed 's/#.*//; s/[[:space:]]*$//' "$1" | grep .; }  # pattern lines, comments stripped
args=("$@")
here=$(dirname "$(readlink -f "$0")")
# Wallpaper mode, one mpv per monitor: AERIAL_INSTANCE names the monitor (socket, window app id) and
# AERIAL_PLAYLIST is that monitor's playlist, both set by the extension (or aerial-wallpaper@.service).
[ ${#args[@]} -eq 0 ] && [ -n "${AERIAL_PLAYLIST:-}" ] && args=("$AERIAL_PLAYLIST")
# Wallpaper mode with no args: the extension's playlist setting, if set.
if [ ${#args[@]} -eq 0 ] && [ "${AERIAL_MODE:-}" = wallpaper ]; then
  schemas=$here/../extension/schemas
  p=$(gsettings --schemadir "$schemas" get org.gnome.shell.extensions.aerial-wallpaper playlist 2>/dev/null | tr -d "'")
  [ -n "$p" ] && args=("$p")
fi
[ ${#args[@]} -eq 0 ] && [ -s "$meta/default" ] && read -r -a args < "$meta/default"
playlist=
if [ ${#args[@]} -eq 1 ] && [ -f "$meta/playlists/${args[0]}.txt" ]; then
  playlist=$meta/playlists/${args[0]}.txt; cats=("${all[@]}")
elif [ ${#args[@]} -eq 0 ] || [ "${args[0]}" = all ]; then
  cats=("${all[@]}")
else
  cats=("${args[@]}")
fi
skip=$meta/skip.txt
mapfile -t files < <(for c in "${cats[@]}"; do find "$root/$c" -name '*.mov' 2>/dev/null; done \
  | { [ -n "$playlist" ] && grep -Ff <(ids "$playlist" | sed "s/.*/[&]/") || cat; } \
  | { [ -s "$skip" ] && grep -vFf <(ids "$skip") || cat; })
[ ${#files[@]} -eq 0 ] && { notify-send "Aerial" "No videos match ${args[*]:-the default}"; exit 1; }
# AERIAL_MODE=wallpaper: a plain window the aerial-wallpaper@viablesys GNOME extension turns into the desktop background.
# Wallpaper mode takes no keyboard or mouse input (Alt+arrows would pan the video, the wheel would seek);
# it is driven only over the IPC socket.
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
sock=$runtime/aerial-mpv.sock extra=()
if [ "${AERIAL_MODE:-}" = wallpaper ]; then
  app=aerial-wallpaper
  if [ -n "${AERIAL_INSTANCE:-}" ]; then
    app=aerial-wallpaper-$AERIAL_INSTANCE sock=$runtime/aerial-mpv-$AERIAL_INSTANCE.sock
    extra=(--script="$here/aerial-now.lua")
  fi
  win=(--wayland-app-id=$app --border=no --keepaspect-window=no --wayland-configure-bounds=no
       --input-default-bindings=no --input-builtin-bindings=no --input-vo-keyboard=no --input-cursor=no
       --input-cursor-passthrough=yes --window-dragging=no)
else
  win=(--fs --input-default-bindings=yes)
fi
exec mpv "${win[@]}" "${extra[@]}" --shuffle --loop-playlist=inf --no-audio --hwdec=auto-safe --background-color=#000000 --force-window=immediate --no-osc --osd-level=0 \
  --really-quiet \
  --input-ipc-server="$sock" --script="$here/log-played.lua" "${files[@]}"
